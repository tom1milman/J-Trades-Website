---
// Fixed, full-page space background: nebula glow (CSS) + twinkling stars and
// occasional shooting stars (canvas). Sits behind all page content.
---

<div class="space" aria-hidden="true">
  <canvas class="space__stars"></canvas>
</div>

<style>
  .space {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 50% at 50% -5%, rgba(0, 56, 184, 0.16), transparent 70%),
      radial-gradient(ellipse 45% 40% at 90% 85%, rgba(76, 141, 255, 0.05), transparent 70%),
      radial-gradient(ellipse 40% 35% at 5% 60%, rgba(60, 70, 200, 0.05), transparent 70%),
      var(--bg);
  }
  .space__stars { display: block; width: 100%; height: 100%; }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.space__stars');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Star = { x: number; y: number; r: number; a: number; speed: number; phase: number; color: string };
    type Meteor = { x: number; y: number; vx: number; vy: number; len: number; life: number; maxLife: number };

    let w = 0;
    let h = 0;
    let stars: Star[] = [];
    const meteors: Meteor[] = [];
    let nextMeteor = 0;

    // Mostly blue stars, from deep flag blue to pale ice blue
    const COLORS = ['76,141,255', '76,141,255', '110,165,255', '140,185,255', '40,110,255', '180,210,255'];

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(700, Math.round((w * h) / 1500));
      stars = Array.from({ length: count }, () => {
        const big = Math.random() < 0.06;
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          r: big ? 1.2 + Math.random() * 0.8 : 0.4 + Math.random() * 0.8,
          a: 0.5 + Math.random() * 0.5,
          speed: 0.6 + Math.random() * 2.2,
          phase: Math.random() * Math.PI * 2,
          color: COLORS[Math.floor(Math.random() * COLORS.length)],
        };
      });
      if (reducedMotion) draw(0);
    }

    function spawnMeteor() {
      // Start somewhere along the top / upper-right, streak down-left.
      const angle = (200 + Math.random() * 25) * (Math.PI / 180);
      const speed = 900 + Math.random() * 600; // px per second
      meteors.push({
        x: w * (0.3 + Math.random() * 0.8),
        y: -20 + Math.random() * h * 0.35,
        vx: Math.cos(angle) * speed, // cos(200°+) is negative → moves left
        vy: -Math.sin(angle) * speed, // sin(200°+) is negative → moves down
        len: 120 + Math.random() * 140,
        life: 0,
        maxLife: 0.7 + Math.random() * 0.5,
      });
    }

    function draw(t: number) {
      ctx!.clearRect(0, 0, w, h);
      const time = t / 1000;

      for (const s of stars) {
        const twinkle = reducedMotion ? 1 : 0.55 + 0.45 * Math.sin(time * s.speed + s.phase);
        ctx!.globalAlpha = s.a * twinkle;
        ctx!.fillStyle = `rgb(${s.color})`;
        ctx!.beginPath();
        ctx!.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx!.fill();
        if (s.r > 1.1) {
          // soft halo on the brightest stars
          ctx!.globalAlpha = s.a * twinkle * 0.15;
          ctx!.beginPath();
          ctx!.arc(s.x, s.y, s.r * 3.5, 0, Math.PI * 2);
          ctx!.fill();
        }
      }
      ctx!.globalAlpha = 1;
    }

    function drawMeteors(dt: number) {
      for (let i = meteors.length - 1; i >= 0; i--) {
        const m = meteors[i];
        m.life += dt;
        m.x += m.vx * dt;
        m.y += m.vy * dt;
        const p = m.life / m.maxLife;
        if (p >= 1) {
          meteors.splice(i, 1);
          continue;
        }
        const fade = p < 0.15 ? p / 0.15 : 1 - (p - 0.15) / 0.85;
        const mag = Math.hypot(m.vx, m.vy);
        const tx = m.x - (m.vx / mag) * m.len;
        const ty = m.y - (m.vy / mag) * m.len;
        const grad = ctx!.createLinearGradient(m.x, m.y, tx, ty);
        grad.addColorStop(0, `rgba(200,220,255,${0.95 * fade})`);
        grad.addColorStop(0.25, `rgba(160,195,255,${0.5 * fade})`);
        grad.addColorStop(1, 'rgba(76,141,255,0)');
        ctx!.strokeStyle = grad;
        ctx!.lineWidth = 1.6;
        ctx!.lineCap = 'round';
        ctx!.beginPath();
        ctx!.moveTo(m.x, m.y);
        ctx!.lineTo(tx, ty);
        ctx!.stroke();
        // bright head
        ctx!.globalAlpha = fade;
        ctx!.fillStyle = 'rgb(200,220,255)';
        ctx!.beginPath();
        ctx!.arc(m.x, m.y, 1.4, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.globalAlpha = 1;
      }
    }

    resize();
    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    });

    if (!reducedMotion) {
      let last = performance.now();
      nextMeteor = last + 1500;
      const loop = (now: number) => {
        const dt = Math.min((now - last) / 1000, 0.05); // clamp after tab switches
        last = now;
        if (now >= nextMeteor) {
          spawnMeteor();
          nextMeteor = now + 2500 + Math.random() * 5000;
        }
        draw(now);
        drawMeteors(dt);
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
