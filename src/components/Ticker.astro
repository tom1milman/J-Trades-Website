---
import fs from 'node:fs';
import path from 'node:path';
import { firms, CODE } from '../data/firms';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Use the square logo only if the file actually exists in public/logos/.
const items = firms.map((f) => ({
  ...f,
  squareSrc:
    f.squareLogo && fs.existsSync(path.join(process.cwd(), 'public', 'logos', f.squareLogo))
      ? `${base}logos/${encodeURIComponent(f.squareLogo)}`
      : null,
}));
// Rendered twice so the -50% translate loops seamlessly.
const loop = [...items, ...items];
---

<div class="ticker" aria-label="Partner firms">
  <div class="ticker__track">
    {loop.map((f, i) => (
      <span class="ticker__item" aria-hidden={i >= firms.length ? 'true' : undefined}>
        {f.squareSrc ? (
          <img class="ticker__logo" src={f.squareSrc} alt="" />
        ) : (
          <span class="ticker__sym">{f.symbol}</span>
        )}
        <span class="ticker__name">{f.name}</span>
        <span class="up">▲ {CODE}</span>
      </span>
    ))}
  </div>
</div>

<style>
  .ticker {
    position: relative;
    overflow: hidden;
    padding: 0.6rem 0;
    background: color-mix(in srgb, var(--primary) 12%, var(--bg));
    border-block: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 40s linear infinite;
  }
  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    white-space: nowrap;
    border-right: 1px solid var(--line);
  }
  .ticker__sym { font-weight: 700; color: var(--text); }
  .ticker__logo {
    width: 1.6rem;
    height: 1.6rem;
    object-fit: contain;
    border-radius: 0.3rem;
    flex: none;
  }
  .ticker__name { color: var(--text-muted); }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .ticker__item[aria-hidden='true'] { display: none; }
  }
</style>

<script>
  // The track scrolls via a CSS animation by default. When JS runs, we take over
  // and move it ourselves each frame, so hovering can ease the speed down to 0
  // and back up without relying on browser-specific playbackRate behavior.
  const DURATION_S = 40; // time for one full loop at normal speed
  const STOP_MS = 700;
  const START_MS = 900;
  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
  const easeInOutCubic = (t: number) =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    document.querySelectorAll<HTMLElement>('.ticker').forEach((ticker) => {
      const track = ticker.querySelector<HTMLElement>('.ticker__track');
      if (!track) return;

      // Start from wherever the CSS animation currently is, then disable it.
      const loopWidth = () => track.scrollWidth / 2;
      let offset = Math.abs(new DOMMatrix(getComputedStyle(track).transform).m41) || 0;
      track.style.animation = 'none';

      let rate = 1; // 1 = normal speed, 0 = stopped
      let tween: { from: number; to: number; start: number; span: number; ease: (t: number) => number } | null = null;
      let last = performance.now();

      const frame = (now: number) => {
        const dt = Math.min(now - last, 100); // avoid jumps after a background tab
        last = now;

        if (tween) {
          const t = Math.min((now - tween.start) / tween.span, 1);
          rate = tween.from + (tween.to - tween.from) * tween.ease(t);
          if (t >= 1) tween = null;
        }

        const w = loopWidth();
        if (w > 0) {
          offset = (offset + (w / (DURATION_S * 1000)) * dt * rate) % w;
          track.style.transform = `translate3d(${-offset}px, 0, 0)`;
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);

      const tweenTo = (to: number, duration: number, ease: (t: number) => number) => {
        // Scale duration by how far we have to go, so reversing mid-tween feels natural.
        const span = Math.max(Math.abs(to - rate), 0.001) * duration;
        tween = { from: rate, to, start: performance.now(), span, ease };
      };

      ticker.addEventListener('mouseenter', () => tweenTo(0, STOP_MS, easeOutCubic));
      ticker.addEventListener('mouseleave', () => tweenTo(1, START_MS, easeInOutCubic));
    });
  }
</script>
