---
import fs from 'node:fs';
import path from 'node:path';
import { firms, CODE } from '../data/firms';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Use the square logo only if the file actually exists in public/logos/.
const items = firms.map((f) => ({
  ...f,
  squareSrc:
    f.squareLogo && fs.existsSync(path.join(process.cwd(), 'public', 'logos', f.squareLogo))
      ? `${base}logos/${encodeURIComponent(f.squareLogo)}`
      : null,
}));
// Rendered twice so the -50% translate loops seamlessly.
const loop = [...items, ...items];
---

<div class="ticker" aria-label="Partner firms">
  <div class="ticker__track">
    {loop.map((f, i) => (
      <span class="ticker__item" aria-hidden={i >= firms.length ? 'true' : undefined}>
        {f.squareSrc ? (
          <img class="ticker__logo" src={f.squareSrc} alt="" />
        ) : (
          <span class="ticker__sym">{f.symbol}</span>
        )}
        <span class="ticker__name">{f.name}</span>
        <span class="up">▲ {CODE}</span>
      </span>
    ))}
  </div>
</div>

<style>
  .ticker {
    position: relative;
    overflow: hidden;
    padding: 0.6rem 0;
    background: color-mix(in srgb, var(--primary) 12%, var(--bg));
    border-block: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 40s linear infinite;
  }
  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    white-space: nowrap;
    border-right: 1px solid var(--line);
  }
  .ticker__sym { font-weight: 700; color: var(--text); }
  .ticker__logo {
    width: 1.6rem;
    height: 1.6rem;
    object-fit: contain;
    border-radius: 0.3rem;
    flex: none;
  }
  .ticker__name { color: var(--text-muted); }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .ticker__item[aria-hidden='true'] { display: none; }
  }
</style>

<script>
  // Ease the ticker to a stop on hover and back up to speed on leave,
  // by tweening the CSS animation's playbackRate instead of pausing it.
  const STOP_MS = 700;
  const START_MS = 900;
  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
  const easeInOutCubic = (t: number) =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

  document.querySelectorAll<HTMLElement>('.ticker').forEach((ticker) => {
    const track = ticker.querySelector<HTMLElement>('.ticker__track');
    const anim = track?.getAnimations()[0];
    if (!anim) return; // reduced motion, or no WAAPI support

    let frame = 0;
    const tweenTo = (target: number, duration: number, ease: (t: number) => number) => {
      cancelAnimationFrame(frame);
      const from = anim.playbackRate;
      const start = performance.now();
      // Scale duration by how far we have to go, so reversing mid-tween feels natural.
      const span = Math.max(Math.abs(target - from), 0.001) * duration;
      const step = (now: number) => {
        const t = Math.min((now - start) / span, 1);
        anim.playbackRate = from + (target - from) * ease(t);
        if (t < 1) frame = requestAnimationFrame(step);
      };
      frame = requestAnimationFrame(step);
    };

    ticker.addEventListener('mouseenter', () => tweenTo(0, STOP_MS, easeOutCubic));
    ticker.addEventListener('mouseleave', () => tweenTo(1, START_MS, easeInOutCubic));
  });
</script>
