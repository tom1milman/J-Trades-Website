---
import FirmCard from './FirmCard.astro';
import { firms } from '../data/firms';
---

<section class="links" id="firms" aria-label="Partner firms">
  <div class="container links__inner">
    <div class="grid" id="firms-grid">
      {firms.map((firm) => <div class="reveal grid__item"><FirmCard firm={firm} /></div>)}
    </div>
    <script is:inline>
      (() => {
        const grid = document.getElementById('firms-grid');
        if (!grid) return;
        const items = Array.from(grid.children);
        for (let i = items.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [items[i], items[j]] = [items[j], items[i]];
        }
        grid.append(...items);
      })();
    </script>
  </div>
</section>

<style>
  .links {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2rem, 6vw, 3.5rem);
  }
  .links__inner { max-width: 960px; }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  .grid__item { display: grid; }
</style>
