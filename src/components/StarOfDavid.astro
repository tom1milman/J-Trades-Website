---
interface Props {
  class?: string;
  strokeWidth?: number;
  /** Animate the two triangles drawing themselves in. */
  draw?: boolean;
}
const { class: className, strokeWidth = 3, draw = false } = Astro.props;
---

<svg
  class:list={['star', className, { 'star--draw': draw }]}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
>
  <path pathLength="1" d="M50 5 88.97 72.5H11.03Z" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round" />
  <path pathLength="1" d="M50 95 11.03 27.5h77.94Z" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round" />
</svg>

<style>
  .star { display: block; overflow: visible; }
  .star--draw path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: star-draw 2.4s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  .star--draw path:nth-child(2) { animation-delay: 0.6s; }
  @keyframes star-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .star--draw path { animation: none; stroke-dashoffset: 0; }
  }
</style>
