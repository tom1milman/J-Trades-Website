---
import StarOfDavid from './StarOfDavid.astro';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__stripe" aria-hidden="true"></div>
  <div class="container footer__inner">
    <div class="footer__legal">
      <p>
        <strong>Affiliate disclosure.</strong> Links on this site are affiliate links. If you sign up through them or use
        code JEW, we may earn a commission at no extra cost to you.
      </p>
      <p>
        <strong>Risk disclaimer.</strong> Nothing here is a financial advice. 
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: clamp(3rem, 8vw, 1rem); }
  .footer__stripe {
    border-top: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .footer__inner { padding-block: 2.5rem 2rem; display: grid; gap: 1.75rem; }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .footer__brand :global(.footer__star) { width: 24px; height: 24px; color: var(--accent); }
  .footer__legal { display: grid; gap: 0.9rem; max-width: 80ch; }
  .footer__legal p { margin: 0; font-size: 0.82rem; line-height: 1.65; color: var(--text-muted); }
  .footer__legal strong { color: var(--text); font-weight: 600; }
  .footer__copy { margin: 0; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); }
</style>
